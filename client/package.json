{
  "name": "client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "build": "npm run lint && tsc && vite build",
    "lint": "eslint .",
    "dev": "vite",
    "build:gh-pages": "vite build --outDir dist-gh-pages --base=/hiding-game/ && node -e \"require('fs').writeFileSync('dist-gh-pages/.nojekyll','')\"",
    "deploy:gh-pages": "npm run build:gh-pages && npx gh-pages -d dist-gh-pages --dotfiles"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.48",
    "@colyseus/sdk": "^0.18.10",
    "@esengine/ecs-framework": "^2.11.2",
    "@pixi/tilemap": "^5.0.2",
    "pixi.js": "^8.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "gh-pages": "^6.3.0",
    "prettier": "^3.5.3",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.25.0",
    "vite": "^6.2.0"
  }
}
